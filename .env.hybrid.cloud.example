# Generated locally by scripts/initialize-hybrid.ps1; keep actual values out of Git.
# New installations default to isolated mode. The current deployment uses original
# data after a verified file migration; see docs/hybrid-deployment.md before switching.
HYBRID_DATA_MODE=isolated
REDIS_DATABASE=1
HYBRID_DOCUMENT_VOLUME=ai-document-agent-cloud_document_data
HYBRID_DOCUMENT_VOLUME_EXTERNAL=false
MYSQL_DATABASE=ai_document_agent_cloud
MYSQL_USER=ai_document_cloud
MYSQL_PASSWORD=generated-by-initializer
REDIS_PASSWORD=copy-from-local-env
RABBITMQ_USERNAME=ai_document_cloud
RABBITMQ_PASSWORD=generated-by-initializer
RABBITMQ_VHOST=/ai-document-agent-cloud
QDRANT_COLLECTION=ai_document_chunks_cloud_v4
QDRANT_INITIALIZATION_STRATEGY=CREATE_IF_MISSING
QDRANT_API_KEY=
KEYWORD_INDEX_NAME=document_chunks_cloud_v1
KEYWORD_INDEX_ALIAS=document_chunks_cloud
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=copy-from-local-env
ELASTICSEARCH_API_KEY=

# Copied from the effective local backend environment, without printing keys.
OPENAI_API_KEY=your-deepseek-api-key
RAG_CHAT_API_KEY=
RAG_CHAT_BASE_URL=https://api.deepseek.com
RAG_CHAT_MODEL=deepseek-flash
RAG_DISABLE_THINKING=true
DASHSCOPE_API_KEY=your-dashscope-api-key
VECTOR_EMBEDDING_API_KEY=
VECTOR_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VECTOR_EMBEDDING_MODEL=text-embedding-v4
VECTOR_EMBEDDING_DIMENSIONS=1024
VECTOR_EMBEDDING_BATCH_SIZE=10
RERANK_ENABLED=false

PROGRESS_TOKEN_FILE=./secrets/hybrid_progress_subscription_token
DOCUMENT_OCR_ENABLED=true
# Lower render memory on the 2 GiB ECS; fine print may need higher DPI.
DOCUMENT_OCR_DPI=150

# Hybrid retrieval crosses the Windows SSH tunnel and can use 30s for query expansion.
# Keep the outer tool timeout longer, with separate bounded per-model and overall deadlines.
RAG_QUERY_EXPANSION_TIMEOUT=30s
AGENT_REACT_TOOL_TIMEOUT=35s
AGENT_REACT_MODEL_TIMEOUT=35s
AGENT_REACT_DEADLINE=120s
AGENT_PLAN_TOOL_TIMEOUT=35s
AGENT_PLAN_MODEL_TIMEOUT=35s
AGENT_PLAN_DEADLINE=180s
