# Copy this file to .env before starting Compose (backend + Nginx + infrastructure).
# Do not commit .env or replace these placeholders with production credentials.

# Web UI: http://localhost:8088. The current deployment has shared access, so bind locally by default.
FRONTEND_BIND_ADDRESS=127.0.0.1
FRONTEND_PORT=8088
# Run scripts/initialize-compose.ps1 once. This file is mounted only into backend/Nginx servers.
PROGRESS_TOKEN_FILE=./secrets/progress_subscription_token

# PDF text extraction falls back to offline Chinese OCR in Docker (engine/models are bundled).
# When running Java directly, install Tesseract + chi_sim/eng data before enabling this.
DOCUMENT_OCR_ENABLED=true
DOCUMENT_OCR_COMMAND=tesseract
DOCUMENT_OCR_LANGUAGE=chi_sim+eng
DOCUMENT_OCR_DPI=300
DOCUMENT_OCR_PAGE_TIMEOUT=60s
DOCUMENT_OCR_DOCUMENT_TIMEOUT=25m
DOCUMENT_OCR_MAX_CONCURRENT_PAGES=1
DOCUMENT_OCR_MAX_PAGES=2000
DOCUMENT_OCR_MAX_RENDERED_PIXELS=16000000

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=ai_document_agent
MYSQL_USER=ai_document_agent
MYSQL_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_USERNAME=ai_document_agent
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
# DeepSeek Chat uses the OpenAI-compatible API. RAG_CHAT_API_KEY is optional and overrides OPENAI_API_KEY.
OPENAI_API_KEY=your-deepseek-api-key
RAG_CHAT_BASE_URL=https://api.deepseek.com
RAG_CHAT_MODEL=deepseek-flash
RAG_CHAT_API_KEY=
# Applied only to the official DeepSeek chat endpoint; bounds latency without replaying reasoning content.
RAG_DISABLE_THINKING=true
# Alibaba Cloud Model Studio Embeddings uses a separate OpenAI-compatible endpoint and API key.
DASHSCOPE_API_KEY=your-dashscope-api-key
VECTOR_EMBEDDING_API_KEY=
VECTOR_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Leave empty for the local Compose Qdrant instance. Set this only for a protected remote Qdrant deployment.
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=ai_document_chunks_dashscope_v4
QDRANT_INITIALIZATION_STRATEGY=CREATE_IF_MISSING
VECTOR_EMBEDDING_MODEL=text-embedding-v4
VECTOR_EMBEDDING_DIMENSIONS=1024
VECTOR_EMBEDDING_BATCH_SIZE=32
VECTOR_EMBEDDING_TIMEOUT=20s
# Local Compose uses the elastic built-in user over HTTP for development. Replace both password placeholders
# locally; production must enable HTTPS and inject credentials through its secret manager.
ELASTICSEARCH_URIS=http://localhost:9200
ELASTIC_PASSWORD=replace-with-a-strong-local-password
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace-with-the-same-local-password
ELASTICSEARCH_API_KEY=
KEYWORD_INDEX_NAME=document_chunks_v1
KEYWORD_INDEX_ALIAS=document_chunks
KEYWORD_INDEX_BULK_SIZE=100
# Cross-Encoder reranking is opt-in. Keep the API key in your local .env or secret manager, never in source control.
RERANK_ENABLED=false
RERANK_PROVIDER=generic
RERANK_URL=
RERANK_MODEL=
RERANK_API_KEY=
RERANK_API_KEY_HEADER=Authorization
RERANK_MAX_CANDIDATES=50
RERANK_MAX_TEXT_LENGTH=4000
RERANK_CONNECT_TIMEOUT=2s
RERANK_READ_TIMEOUT=5s
RERANK_MAX_RETRIES=1
RERANK_CIRCUIT_FAILURE_THRESHOLD=3
RERANK_CIRCUIT_OPEN_DURATION=30s
# RAG quality controls: candidate limits belong to retrieval; final TopK remains the API request size.
RETRIEVAL_VECTOR_TOP_K=20
RETRIEVAL_KEYWORD_TOP_K=20
RAG_MAX_CONTEXT_CHARACTERS=32000
RAG_MAX_CHUNK_CHARACTERS=4500
RAG_QUERY_EXPANSION_ENABLED=true
RAG_MAX_RETRIEVAL_QUERIES=3
RAG_RETRIEVAL_CANDIDATE_TOP_K=20
# Experimental grounded-answer protocol; enable explicitly after reviewing benchmark results.
AGENT_STRUCTURED_ANSWERS=false
AGENT_MAX_REGISTERED_SOURCES=80
RAG_QUERY_EXPANSION_TIMEOUT=30s
# Agent execution keeps model, tool, evidence, and output budgets separate.
AGENT_RERANK=true
AGENT_REACT_MAX_STEPS=6
AGENT_REACT_REQUIRE_INITIAL_SEARCH=true
AGENT_REACT_MAX_TOOL_CALLS=6
AGENT_REACT_MAX_CHUNK_CHARACTERS=4500
AGENT_REACT_MAX_EVIDENCE_TOKENS=8000
AGENT_REACT_MAX_OUTPUT_TOKENS=1536
AGENT_PLAN_MAX_EVIDENCE_TOKENS=8000
AGENT_PLAN_OUTPUT_TOKENS=1024
AGENT_PLAN_SYNTHESIS_TOKENS=2048
AGENT_PLAN_JSON_PLANNING=true
AGENT_PLAN_TRANSIENT_RETRIES=1
# 运行时语义覆盖检查；先用固定 benchmark 验证收益再启用。
AGENT_PLAN_VERIFY_EVIDENCE=false
