# Copy this file to .env before starting local infrastructure.
# Do not commit .env or replace these placeholders with production credentials.

MYSQL_ROOT_PASSWORD=change-me
MYSQL_DATABASE=ai_document_agent
MYSQL_USER=ai_document_agent
MYSQL_PASSWORD=change-me
REDIS_PASSWORD=change-me
RABBITMQ_USERNAME=ai_document_agent
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/
# DeepSeek Chat uses the OpenAI-compatible API. RAG_CHAT_API_KEY is optional and overrides OPENAI_API_KEY.
OPENAI_API_KEY=your-deepseek-api-key
RAG_CHAT_BASE_URL=https://api.deepseek.com
RAG_CHAT_MODEL=deepseek-flash
RAG_CHAT_API_KEY=
# Alibaba Cloud Model Studio Embeddings uses a separate OpenAI-compatible endpoint and API key.
DASHSCOPE_API_KEY=your-dashscope-api-key
VECTOR_EMBEDDING_API_KEY=
VECTOR_EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# Leave empty for the local Compose Qdrant instance. Set this only for a protected remote Qdrant deployment.
QDRANT_API_KEY=
QDRANT_HOST=localhost
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
QDRANT_COLLECTION=ai_document_chunks_dashscope_v4
QDRANT_INITIALIZATION_STRATEGY=CREATE_IF_MISSING
VECTOR_EMBEDDING_MODEL=text-embedding-v4
VECTOR_EMBEDDING_DIMENSIONS=1024
VECTOR_EMBEDDING_BATCH_SIZE=32
VECTOR_EMBEDDING_TIMEOUT=20s
# Local Compose uses the elastic built-in user over HTTP for development. Replace both password placeholders
# locally; production must enable HTTPS and inject credentials through its secret manager.
ELASTICSEARCH_URIS=http://localhost:9200
ELASTIC_PASSWORD=replace-with-a-strong-local-password
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=replace-with-the-same-local-password
ELASTICSEARCH_API_KEY=
KEYWORD_INDEX_NAME=document_chunks_v1
KEYWORD_INDEX_ALIAS=document_chunks
KEYWORD_INDEX_BULK_SIZE=100
# Cross-Encoder reranking is opt-in. Keep the API key in your local .env or secret manager, never in source control.
RERANK_ENABLED=false
RERANK_URL=
RERANK_API_KEY=
RERANK_API_KEY_HEADER=Authorization
RERANK_MAX_CANDIDATES=50
RERANK_MAX_TEXT_LENGTH=4000
RERANK_CONNECT_TIMEOUT=2s
RERANK_READ_TIMEOUT=5s
RERANK_MAX_RETRIES=1
RERANK_CIRCUIT_FAILURE_THRESHOLD=3
RERANK_CIRCUIT_OPEN_DURATION=30s
