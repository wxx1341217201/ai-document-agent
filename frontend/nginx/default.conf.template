map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

# The cloud frontend is loopback-only; its HTTPS gateway supplies this header.
map $http_x_forwarded_proto $aida_forwarded_proto {
    default $scheme;
    https https;
    http http;
}

map $uri $asset_cache_control {
    default "no-store";
    ~^/assets/ "public, max-age=31536000, immutable";
}

server {
    listen __AIDA_NGINX_LISTEN__;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;
    server_tokens off;

    # Docker DNS is resolved again after a backend container is replaced.
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $backend __AIDA_BACKEND_URL__;

    # Match Spring's 21 MB multipart request limit (20 MB file + form overhead).
    client_max_body_size 21m;
    proxy_connect_timeout 5s;
    proxy_send_timeout 120s;
    proxy_read_timeout 120s;
    proxy_next_upstream off;

    add_header Cache-Control $asset_cache_control always;
    # Emit one value even when the backend also sets its download safety header.
    proxy_hide_header X-Content-Type-Options;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy same-origin always;
    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml;
    gzip_min_length 1024;

    # This probes Nginx only; backend readiness has its own Compose health check.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    location = /api { return 404; }
    location ^~ /api/ {
        # $request_uri retains both /api/v1 and the query string.
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $aida_forwarded_proto;
        proxy_set_header Connection "";
    }

    location = /ws { return 404; }
    location ^~ /ws/ {
        proxy_pass $backend$request_uri;
        proxy_http_version 1.1;
        # Keeping Host (including its port) and Origin makes Spring's same-origin check work.
        proxy_set_header Host $http_host;
        proxy_set_header X-Forwarded-Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $aida_forwarded_proto;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Authorization "Bearer __PROGRESS_SUBSCRIPTION_TOKEN__";
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_buffering off;
    }

    location ^~ /assets/ { try_files $uri =404; }
    location = /mockServiceWorker.js { return 404; }
    location ~ /\. { return 404; }
    location ~ ^/(actuator|v3/api-docs|swagger-ui)(/|$) { return 404; }

    # Direct navigation and refresh of chat/document/execution URLs use React Router.
    location / { try_files $uri $uri/ /index.html; }
}
